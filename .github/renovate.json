{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "gomod"],
  "automerge": false,
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Dependabot owns ordinary Go module updates",
      "matchManagers": ["gomod"],
      "enabled": false
    },
    {
      "description": "Dependabot owns the frontend npm dependency reflected by this recommended custom matcher",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["@tsconfig/node22"],
      "enabled": false
    },
    {
      "description": "Track the Go language version without raising the supported source floor",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": true,
      "rangeStrategy": "bump",
      "allowedVersions": "<1.28.0"
    },
    {
      "description": "Resolve the untagged OPA submodule through the Go proxy, not parent-repository releases",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/open-policy-agent/frameworks/constraint"],
      "enabled": true
    },
    {
      "description": "Patch the supported Go compiler line without silently raising the source compatibility floor",
      "matchDatasources": ["golang-version"],
      "allowedVersions": "<1.28.0"
    },
    {
      "description": "Keep OCI image references immutable",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Require coordinated review for system package pins",
      "matchDatasources": ["repology", "deb"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Resolve full Debian binary package versions, not source or normalized Repology versions",
      "matchDatasources": ["deb"],
      "registryUrls": ["https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64"]
    },
    {
      "description": "Review version, commit, and module checksum together before updating these built tools",
      "matchPackageNames": [
        "cilium/pwru",
        "kastenhq/kubestr",
        "kubernetes-sigs/kind"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated tool versions and image tags outside Dependabot-supported dependency manifests",
      "managerFilePatterns": [
        "/(^|/)(Makefile|versions\\.env|deps\\.lock)$/",
        "/(^|/)Dockerfile$/",
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^(hack|scripts|e2e|test|internal|pkg|utils)/.*\\.(sh|ya?ml|go|lock|env)$/"
      ],
      "matchStrings": [
        "(?:#|//) renovate: datasource=(?<datasource>go|github-releases|docker|golang-version) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\r?\\n[^\\r\\n]*?(?<currentValue>v?\\d+\\.\\d+(?:\\.\\d+)?(?:-[0-9A-Za-z.-]+)?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
      "extractVersionTemplate": "{{{extractVersion}}}"
    },
    {
      "customType": "regex",
      "description": "Exact Alpine and Debian package revisions; full revisions are preserved",
      "managerFilePatterns": [
        "/(^|/)(versions\\.env|deps\\.lock|Dockerfile)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>repology|deb) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\r?\\n[^\\r\\n]*?=[\"']?(?<currentValue>[0-9A-Za-z][0-9A-Za-z.+:~_-]*)"
      ],
      "versioningTemplate": "{{{versioning}}}"
    }
  ]
}
