#!/bin/sh
# SPDX-FileCopyrightText: 2026 Deutsche Telekom AG
# SPDX-License-Identifier: Apache-2.0

set -eu

# The image-owned commands intentionally have a small, fixed surface.  Keep
# all evidence below /work (the only path normally mounted by a debug session)
# and never interpolate a command through a shell.
WORK_DIR=${NETWORK_DEBUG_WORK_DIR:-/work}
STAGING_DIR=''
MAX_FILTER_LENGTH=256
MAX_CAPTURE_PACKETS=10000
MAX_TRACE_EVENTS=10000

usage_error() {
	printf 'net-debug: %s\n' "$*" >&2
	exit 2
}

bounded_integer() {
	value=$1 minimum=$2 maximum=$3 label=$4
	case "$value" in
		''|*[!0-9]*) usage_error "$label must be an integer between $minimum and $maximum" ;;
	esac
	if [ "$value" -lt "$minimum" ] || [ "$value" -gt "$maximum" ]; then
		usage_error "$label must be an integer between $minimum and $maximum"
	fi
}

validate_filter() {
	filter=$1
	[ "${#filter}" -le "$MAX_FILTER_LENGTH" ] || usage_error 'filter is too long'
newline='
'
	carriage_return=$(printf '\rX')
	carriage_return=${carriage_return%X}
	case "$filter" in
		*"$newline"*|*"$carriage_return"*) usage_error 'filter must not contain a newline' ;;
	esac
}

validate_output() {
	output=$1
	case "$output" in
		''|.|..|*/*|*\\*) usage_error 'output must be a filename under /work' ;;
		*[!A-Za-z0-9._-]*) usage_error 'output contains unsupported characters' ;;
		?????????????????????????????????????????????????????????????????*) usage_error 'output filename is too long' ;;
	esac
	if [ ! -d "$WORK_DIR" ] || [ -L "$WORK_DIR" ]; then
		usage_error "/work is not available"
	fi
	destination=$WORK_DIR/$output
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		usage_error 'output already exists'
	fi
}

validate_interface() {
	interface=$1
	case "$interface" in
		any) ;;
		''|????????????????*) usage_error 'interface must be any or at most 15 characters' ;;
		*[!A-Za-z0-9._-]*) usage_error 'interface contains unsupported characters' ;;
	esac
}

cleanup_child() {
	if [ -n "${ACTIVE_PID:-}" ]; then
		kill -INT "$ACTIVE_PID" 2>/dev/null || true
		kill -TERM "$ACTIVE_PID" 2>/dev/null || true
	fi
	if [ -n "${WATCHDOG_PID:-}" ]; then
		kill "$WATCHDOG_PID" 2>/dev/null || true
	fi
	if [ -n "${TEMP_EVIDENCE:-}" ]; then
		rm -f "$TEMP_EVIDENCE" "$TEMP_EVIDENCE.err"
	fi
	cleanup_stage
}

cleanup_stage() {
	if [ -n "${STAGING_DIR:-}" ]; then
		rm -f "$STAGING_DIR"/* 2>/dev/null || true
		rmdir "$STAGING_DIR" 2>/dev/null || true
		STAGING_DIR=''
	fi
}

capture_command() {
	umask 077
	interface=any duration=30 packets=1000 snaplen=128 filter='' output=capture.pcap
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--interface|-i) [ "$#" -ge 2 ] || usage_error 'missing interface'; interface=$2; shift 2 ;;
			--duration|-d) [ "$#" -ge 2 ] || usage_error 'missing duration'; duration=$2; shift 2 ;;
			--packets|--count|--max-packets|-c) [ "$#" -ge 2 ] || usage_error 'missing packet limit'; packets=$2; shift 2 ;;
			--snaplen|-s) [ "$#" -ge 2 ] || usage_error 'missing snaplen'; snaplen=$2; shift 2 ;;
			--filter|-f) [ "$#" -ge 2 ] || usage_error 'missing filter'; filter=$2; shift 2 ;;
			--output|--output-file|-o) [ "$#" -ge 2 ] || usage_error 'missing output'; output=$2; shift 2 ;;
			--help|-h)
				printf '%s\n' 'Usage: net-debug capture [--interface IF] [--duration SEC] [--packets N] [--snaplen BYTES] [--filter EXPR] [--output FILE]'
				return 0 ;;
			*) usage_error "unknown capture option: $1" ;;
		esac
	done
	bounded_integer "$duration" 1 300 duration
	bounded_integer "$packets" 1 "$MAX_CAPTURE_PACKETS" packets
	bounded_integer "$snaplen" 64 256 snaplen
	validate_interface "$interface"
	validate_filter "$filter"
	validate_output "$output"
	command -v tcpdump >/dev/null 2>&1 || usage_error 'tcpdump is unavailable'

	destination=$WORK_DIR/$output
	# mktemp creates a private, mode-700 staging directory with O_EXCL.  Keep
	# all intermediate files there, then publish with a no-clobber hard link.
	STAGING_DIR=$(mktemp -d "$WORK_DIR/.net-debug.XXXXXX") || usage_error 'cannot create private staging directory'
	TEMP_EVIDENCE=$STAGING_DIR/evidence
	trap cleanup_child EXIT
	trap 'cleanup_child; exit 130' HUP INT TERM
	if [ -n "$filter" ]; then
		# -d asks libpcap to compile the expression without opening the device.
		tcpdump -d -- "$filter" >/dev/null 2>"$TEMP_EVIDENCE.err" || {
			printf 'net-debug: filter rejected by libpcap\n' >&2
			return 1
		}
	fi

	# Keep this argv literal and reviewable: in particular, -p prevents
	# tcpdump from enabling promiscuous mode on the target interface.
	tcpdump -p -i "$interface" -s "$snaplen" -c "$packets" -w "$TEMP_EVIDENCE" -- ${filter:+"$filter"} >"$TEMP_EVIDENCE.err" 2>&1 &
	ACTIVE_PID=$!
	(
		sleep "$duration"
		kill -INT "$ACTIVE_PID" 2>/dev/null || true
		sleep 2
		kill -TERM "$ACTIVE_PID" 2>/dev/null || true
		sleep 1
		kill -KILL "$ACTIVE_PID" 2>/dev/null || true
	) &
	WATCHDOG_PID=$!
	status=0
	wait "$ACTIVE_PID" || status=$?
	ACTIVE_PID=''
	kill "$WATCHDOG_PID" 2>/dev/null || true
	wait "$WATCHDOG_PID" 2>/dev/null || true
	WATCHDOG_PID=''
	case "$status" in 0|130|143) ;; *) cat "$TEMP_EVIDENCE.err" >&2; return 1 ;; esac
	[ -s "$TEMP_EVIDENCE" ] || usage_error 'tcpdump produced no capture'
	readback=$TEMP_EVIDENCE.readback
	tcpdump -nn -tt -r "$TEMP_EVIDENCE" -c "$packets" >"$readback" 2>/dev/null || return 1
	count=$(wc -l <"$readback" | tr -d ' ')
	bytes=$(wc -c <"$TEMP_EVIDENCE" | tr -d ' ')
	max_bytes=$((packets * (snaplen + 16) + 24))
	[ "$bytes" -le "$max_bytes" ] || usage_error 'capture exceeds its bounded file size'
	hash=$(sha256sum "$TEMP_EVIDENCE" | awk '{print $1}')
	ln "$TEMP_EVIDENCE" "$destination" || usage_error 'output was created concurrently'
	rm -f "$TEMP_EVIDENCE"
	cleanup_stage
	printf 'capture\ninterface %s\nduration %s\npacket_limit %s\nsnaplen %s\npacket_count %s\nbytes %s\nsha256 %s\nfile %s\n' \
		"$interface" "$duration" "$packets" "$snaplen" "$count" "$bytes" "$hash" "$output"
}

capability_present() {
	status_file=${NETWORK_DEBUG_CAPABILITY_FILE:-/proc/self/status}
	cap=$1
	case "$cap" in
		NET_RAW) bit=13 ;; NET_ADMIN) bit=12 ;; SYS_PTRACE) bit=19 ;; SYS_RESOURCE) bit=24 ;; PERFMON) bit=38 ;; BPF) bit=39 ;;
		*) return 1 ;;
	esac
	hex=$(awk '/^CapEff:/ {print $2}' "$status_file" 2>/dev/null || true)
	[ -n "$hex" ] || return 1
	nibble_index=$((bit / 4))
	while [ "$nibble_index" -gt 0 ]; do
		hex=${hex%?}
		nibble_index=$((nibble_index - 1))
	done
	nibble=$(printf '%s' "$hex" | tail -c 1 | tr 'A-F' 'a-f')
	case "$((bit % 4)):$nibble" in
		0:[13579bdf]|1:[2367abef]|2:[4567cdef]|3:[89abcdef]) return 0 ;;
		*) return 1 ;;
	esac
}

trace_prerequisites() {
	btf=${NETWORK_DEBUG_BTF_PATH:-/sys/kernel/btf/vmlinux}
	debugfs=${NETWORK_DEBUG_DEBUGFS_PATH:-/sys/kernel/debug}
	tracefs=${NETWORK_DEBUG_TRACEFS_PATH:-/sys/kernel/tracing}
	securityfs=${NETWORK_DEBUG_SECURITYFS_PATH:-/sys/kernel/security}
	mounts=${NETWORK_DEBUG_MOUNTINFO_PATH:-/proc/self/mountinfo}
	[ -r "$btf" ] || usage_error 'kernel BTF is unavailable or unreadable'
	if [ ! -d "$debugfs" ] || [ ! -r "$debugfs" ]; then
		usage_error 'debugfs is unavailable or unreadable'
	fi
	if [ ! -d "$tracefs" ] || [ ! -r "$tracefs" ]; then
		usage_error 'tracefs is unavailable or unreadable'
	fi
	if [ ! -d "$securityfs" ] || [ ! -r "$securityfs" ]; then
		usage_error 'securityfs is unavailable or unreadable'
	fi
	[ -r "$securityfs/lsm" ] || usage_error 'LSM policy information is unavailable'
	[ -r "$mounts" ] || usage_error 'mount information is unavailable'
	for mountpoint in "$debugfs" "$tracefs" "$securityfs"; do
		grep -F " $mountpoint" "$mounts" >/dev/null 2>&1 || usage_error "$mountpoint is not mounted"
	done
	# Reading /proc/1/ns/net is the kernel-enforced host-PID identity check.
	# Yama and other ptrace policies require CAP_SYS_PTRACE for that read even
	# when the process is root; request only this capability rather than a broad
	# SYS_ADMIN or privileged fallback.
	for capability in NET_ADMIN BPF PERFMON SYS_RESOURCE SYS_PTRACE; do
		capability_present "$capability" || usage_error "required capability $capability is unavailable"
	done
	# /proc/1 is the host init only when the trace pod uses hostPID. Requiring
	# the namespace identity to match is an actual kernel check; a caller cannot
	# satisfy it by setting an environment variable. Trace runbooks therefore
	# require hostPID=true together with hostNetwork=true.
	self_netns=$(readlink /proc/self/ns/net 2>/dev/null || true)
	host_netns=$(readlink /proc/1/ns/net 2>/dev/null || true)
	if [ -z "$self_netns" ] || [ "$self_netns" != "$host_netns" ]; then
		usage_error 'trace requires the host network namespace (hostPID=true and hostNetwork=true)'
	fi
}

trace_command() {
	umask 077
	duration=60 events=1000 filter='' output=trace.log
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--duration|-d) [ "$#" -ge 2 ] || usage_error 'missing duration'; duration=$2; shift 2 ;;
			--events|--lines|--max-events|--max-lines|--line-limit|--limit|-e) [ "$#" -ge 2 ] || usage_error 'missing event limit'; events=$2; shift 2 ;;
			--filter|-f) [ "$#" -ge 2 ] || usage_error 'missing filter'; filter=$2; shift 2 ;;
			--output|--output-file|-o) [ "$#" -ge 2 ] || usage_error 'missing output'; output=$2; shift 2 ;;
			--help|-h)
				printf '%s\n' 'Usage: net-debug trace [--duration SEC] [--events N] [--filter EXPR] [--output FILE]'
				return 0 ;;
			*) usage_error "unknown trace option: $1" ;;
		esac
	done
	bounded_integer "$duration" 1 60 duration
	bounded_integer "$events" 1 "$MAX_TRACE_EVENTS" events
	validate_filter "$filter"
	validate_output "$output"
	trace_prerequisites
	command -v pwru >/dev/null 2>&1 || usage_error 'pwru is unavailable'
	stop_timeout=${NETWORK_DEBUG_PWRU_STOP_TIMEOUT_SECONDS:-15}
	bounded_integer "$stop_timeout" 1 60 stop-timeout
	command -v timeout >/dev/null 2>&1 || usage_error 'timeout is unavailable'
	# Use the same private O_EXCL staging directory as capture. Evidence is
	# written directly to an owned regular file; a FIFO can deadlock when either
	# endpoint is waiting for the other during startup or shutdown.
	destination=$WORK_DIR/$output
	STAGING_DIR=$(mktemp -d "$WORK_DIR/.net-debug.XXXXXX") || usage_error 'cannot create private staging directory'
	TEMP_EVIDENCE=$STAGING_DIR/evidence
	trap cleanup_child EXIT
	trap 'cleanup_child; exit 130' HUP INT TERM

	# pwru has a native line bound. The file-size limit is an independent kernel
	# bound for malformed or unexpectedly large event records (512-byte units).
	max_trace_bytes=$((events * 4097))
	max_trace_blocks=$(((max_trace_bytes + 511) / 512))
	if [ -n "$filter" ]; then
		# shellcheck disable=SC2016 # $1/$@ are intentionally expanded by the child shell.
		(timeout --foreground --signal=INT --kill-after="${stop_timeout}s" "${duration}s" \
			sh -c 'ulimit -f "$1"; shift; exec "$@"' sh "$max_trace_blocks" pwru \
			--backend kprobe --output-tuple --timestamp none --output-limit-lines "$events" -- "$filter") \
			>"$TEMP_EVIDENCE" 2>&1 &
	else
		# shellcheck disable=SC2016 # $1/$@ are intentionally expanded by the child shell.
		(timeout --foreground --signal=INT --kill-after="${stop_timeout}s" "${duration}s" \
			sh -c 'ulimit -f "$1"; shift; exec "$@"' sh "$max_trace_blocks" pwru \
			--backend kprobe --output-tuple --timestamp none --output-limit-lines "$events") \
			>"$TEMP_EVIDENCE" 2>&1 &
	fi
	ACTIVE_PID=$!
	status=0
	wait "$ACTIVE_PID" || status=$?
	ACTIVE_PID=''
	# timeout returns 124 when it delivered the primary signal; 137/143 are
	# retained for compatible implementations that report the forced stop.
	case "$status" in 0|124|130|137|141|143) ;; *) return 1 ;; esac
	count=$(wc -l <"$TEMP_EVIDENCE" | tr -d ' ')
	[ "$count" -le "$events" ] || usage_error 'trace evidence exceeded event limit'
	bytes=$(wc -c <"$TEMP_EVIDENCE" | tr -d ' ')
	[ "$bytes" -le "$max_trace_bytes" ] || usage_error 'trace evidence exceeds its bounded file size'
	hash=$(sha256sum "$TEMP_EVIDENCE" | awk '{print $1}')
	ln "$TEMP_EVIDENCE" "$destination" || usage_error 'output was created concurrently'
	rm -f "$TEMP_EVIDENCE"
	cleanup_stage
	printf 'trace\nduration %s\nevent_limit %s\nevent_count %s\nsha256 %s\nfile %s\n' \
		"$duration" "$events" "$count" "$hash" "$output"
}

help() {
	cat <<'EOF'
network-debug - a portable network troubleshooting toolbox

Usage:
  net-debug shell [COMMAND ...]   Start a shell (the default)
  net-debug report                Print a stable, redaction-friendly report
  net-debug tools                 List installed troubleshooting tools
  net-debug capture               Run a bounded tcpdump capture under /work
  net-debug trace                 Run a bounded pwru trace under /work
  net-debug --help                Show this help
  net-debug --version             Show the image version

The image is intentionally generic. It contains no cluster, registry, cloud,
or organization-specific configuration. tcpdump and pwru may require host
network access, CAP_NET_RAW, CAP_NET_ADMIN, and (for pwru) BPF permissions.
EOF
}

case "${1:-shell}" in
	--help|-h|help) help ;;
	--version|-V|version) printf 'network-debug %s\n' "${NETWORK_DEBUG_VERSION:-unknown}" ;;
	report) exec /usr/local/bin/net-report ;;
	tools) exec /usr/local/bin/net-report --tools ;;
	capture) shift; capture_command "$@" ;;
	trace) shift; trace_command "$@" ;;
	shell)
		shift || true
		if [ "$#" -gt 0 ]; then exec "$@"; fi
		if [ -t 0 ] && [ -t 1 ]; then
			# /etc/profile prints the short MOTD for interactive shells.
			exec /bin/sh -l
		fi
		exec /bin/sh
		;;
	*)
		# Permit the image to be used as a transparent command wrapper.
		exec "$@"
		;;
esac
