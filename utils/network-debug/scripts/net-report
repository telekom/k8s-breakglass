#!/bin/sh
# SPDX-FileCopyrightText: 2026 Deutsche Telekom AG
# SPDX-License-Identifier: Apache-2.0

set -eu

version=${NETWORK_DEBUG_VERSION:-unknown}

help() {
	cat <<'EOF'
net-report - print a deterministic network diagnostics report

Usage: net-report [--help] [--version] [--tools]

The report intentionally omits timestamps, hostnames, command history, and
credentials. Values describe the current network namespace and may therefore
change between invocations.
EOF
}

tool_version() {
	name=$1
	if command -v "$name" >/dev/null 2>&1; then
		case "$name" in
			kubestr)
				value=$(kubestr version 2>/dev/null | sed -n '1p' || true)
				printf '%s\t%s\n' "$name" "${value:-installed}"
				;;
			pwru)
				value=$(pwru --version 2>/dev/null | sed -n '1p' || true)
				printf '%s\t%s\n' "$name" "${value:-installed}"
				;;
			*) printf '%s\tinstalled\n' "$name" ;;
		esac
	else
		printf '%s\tunavailable\n' "$name"
	fi
}

case "${1:-}" in
	--help|-h) help; exit 0 ;;
	--version|-V) printf 'net-report %s\n' "$version"; exit 0 ;;
	--tools)
		printf 'tool\tstatus\n'
		for tool in curl dig host nslookup nc ping tracepath traceroute mtr ip ss tcpdump ethtool kubestr pwru; do tool_version "$tool"; done
		exit 0
		;;
	'') : ;;
	*) printf 'net-report: unknown option: %s\n' "$1" >&2; help >&2; exit 2 ;;
esac

printf 'network-debug report %s\n' "$version"
printf '\n[interfaces]\n'
if command -v ip >/dev/null 2>&1; then ip -o address show 2>/dev/null | LC_ALL=C sort -k2,2 -k3,3 -k4,4 || true; else printf 'unavailable\n'; fi
printf '\n[routes]\n'
if command -v ip >/dev/null 2>&1; then ip -o route show 2>/dev/null | LC_ALL=C sort || true; else printf 'unavailable\n'; fi
printf '\n[rules]\n'
if command -v ip >/dev/null 2>&1; then ip -o rule show 2>/dev/null | LC_ALL=C sort || true; else printf 'unavailable\n'; fi
printf '\n[dns]\n'
awk '$1 == "nameserver" { print $2 }' /etc/resolv.conf 2>/dev/null | LC_ALL=C sort -u || true
printf '\n[tools]\n'
"$0" --tools
