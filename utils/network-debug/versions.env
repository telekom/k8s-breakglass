# Image inputs that are not owned by a Dependabot-tracked manifest. The base
# and builder images are pinned by digest in Dockerfile (Dependabot docker);
# pwru and its Go module graph are pinned by pwru/go.mod and pwru/go.sum
# (Dependabot gomod). The built pwru module versions are recorded in
# /usr/share/breakglass/pwru-build-info.
IMAGE_VERSION=0.1.0
BASE_IMAGE=ghcr.io/nicolaka/netshoot:v0.16@sha256:b09d9b21381f47a79b3cbcb30da25266dc17186ea00ae65e99fdc51396f48e70
BASE_SOURCE=https://github.com/nicolaka/netshoot/tree/v0.16
BASE_VERSION=v0.16
# apk upgrade uses the latest patch in this pinned minor release series.
BASE_ALPINE_VERSION=3.24
BUILD_IMAGE=golang:1.27.3@sha256:957861185dbf29d93668ace41e011d091c6e779953d47f0316ef2cc58e28fe2b
PWRU_SOURCE=https://github.com/cilium/pwru
PWRU_LICENSE=Apache-2.0
PWRU_MODULE_LOCK=pwru/go.mod
PWRU_BUILD_POLICY=go-module-from-tracked-go-sum-built-with-pinned-toolchain
