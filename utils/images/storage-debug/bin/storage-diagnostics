#!/bin/sh
# SPDX-FileCopyrightText: 2026 Deutsche Telekom AG
# SPDX-License-Identifier: Apache-2.0

set -eu

KUBESTR=/usr/libexec/storage-debug/kubestr
STORAGE_REPORT=/usr/local/bin/storage-report
UPSTREAM_RUNBOOK=/usr/share/breakglass/runbooks/upstream/storage-diagnostics/RUNBOOK.md
if [ ! -x "$STORAGE_REPORT" ]; then
    script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
    [ -x "$script_dir/storage-report" ] && STORAGE_REPORT=$script_dir/storage-report
    source_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
    [ -r "$source_root/RUNBOOK.md" ] && UPSTREAM_RUNBOOK=$source_root/RUNBOOK.md
fi
NAMESPACE=${POD_NAMESPACE:-}
WORKLOAD_IMAGE=${STORAGE_DEBUG_WORKLOAD_IMAGE:-}

usage() {
    cat <<'EOF'
storage-diagnostics: bounded storage-diagnostics intent dispatcher

Usage:
  storage-diagnostics mounted-volume [storage-report options]
  storage-diagnostics performance --storage-class NAME [--pvc-size SIZE]
  storage-diagnostics snapshot-restore --storage-class NAME --snapshot-class NAME
  storage-diagnostics snapshot-source-clone --storage-class NAME --snapshot-class NAME
  storage-diagnostics block-volume --storage-class NAME
  storage-diagnostics plan OPERATION [operation options]
  storage-diagnostics docs
  storage-diagnostics runbook
  storage-diagnostics help

SIZE is one of 4Gi, 8Gi, 16Gi, or 32Gi. Cluster operations infer their
namespace from POD_NAMESPACE and require a provider-owned immutable image in
STORAGE_DEBUG_WORKLOAD_IMAGE. They do not accept user-selected commands,
images, namespaces, node selectors, capabilities, service accounts, or RBAC.
EOF
}

fail() {
    printf 'storage-diagnostics: %s\n' "$1" >&2
    exit 2
}

valid_kubernetes_name() {
    value=$1
    [ "${#value}" -le 253 ] || return 1
    printf '%s\n' "$value" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$'
}

valid_namespace() {
    value=$1
    [ "${#value}" -le 63 ] || return 1
    printf '%s\n' "$value" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?$'
}

validate_cluster_context() {
    valid_namespace "$NAMESPACE" || fail "POD_NAMESPACE must be a valid Kubernetes namespace"
    case "$WORKLOAD_IMAGE" in
        *@sha256:????????????????????????????????????????????????????????????????) ;;
        *) fail "STORAGE_DEBUG_WORKLOAD_IMAGE must be an immutable OCI image@sha256 reference" ;;
    esac
    digest=${WORKLOAD_IMAGE##*@sha256:}
    printf '%s\n' "$digest" | grep -Eq '^[0-9a-f]{64}$' || \
        fail "STORAGE_DEBUG_WORKLOAD_IMAGE must use a lowercase sha256 digest"
}

parse_storage_class() {
    STORAGE_CLASS=
    PVC_SIZE=4Gi
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --storage-class)
                [ "$#" -ge 2 ] || fail "--storage-class needs a value"
                STORAGE_CLASS=$2
                shift 2
                ;;
            --pvc-size)
                [ "$#" -ge 2 ] || fail "--pvc-size needs a value"
                PVC_SIZE=$2
                shift 2
                ;;
            *) fail "unsupported performance option: $1" ;;
        esac
    done
    valid_kubernetes_name "$STORAGE_CLASS" || fail "--storage-class must be a valid Kubernetes name"
    case "$PVC_SIZE" in
        4Gi|8Gi|16Gi|32Gi) ;;
        *) fail "--pvc-size must be one of 4Gi, 8Gi, 16Gi, or 32Gi" ;;
    esac
}

parse_snapshot_classes() {
    STORAGE_CLASS=
    SNAPSHOT_CLASS=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --storage-class)
                [ "$#" -ge 2 ] || fail "--storage-class needs a value"
                STORAGE_CLASS=$2
                shift 2
                ;;
            --snapshot-class)
                [ "$#" -ge 2 ] || fail "--snapshot-class needs a value"
                SNAPSHOT_CLASS=$2
                shift 2
                ;;
            *) fail "unsupported snapshot option: $1" ;;
        esac
    done
    valid_kubernetes_name "$STORAGE_CLASS" || fail "--storage-class must be a valid Kubernetes name"
    valid_kubernetes_name "$SNAPSHOT_CLASS" || fail "--snapshot-class must be a valid Kubernetes name"
}

print_plan() {
    printf 'schema_version=storage-diagnostics/v1\n'
    printf 'intent=storage-diagnostics\n'
    printf 'operation=%s\n' "$1"
    shift
    printf 'namespace=%s\n' "$NAMESPACE"
    printf 'workload_image=%s\n' "$WORKLOAD_IMAGE"
    printf 'command='
    printf '%s' "$KUBESTR"
    for arg in "$@"; do
        printf ' %s' "$arg"
    done
    printf '\n'
}

run_cluster_operation() {
    plan=$1
    operation=$2
    shift 2
    validate_cluster_context
    if [ "$plan" = true ]; then
        print_plan "$operation" "$@"
        return
    fi
    [ -x "$KUBESTR" ] || fail "the pinned kubestr executable is unavailable"
    result_file=$(mktemp "${TMPDIR:-/tmp}/storage-diagnostics-result.XXXXXX")
    progress_file=$(mktemp "${TMPDIR:-/tmp}/storage-diagnostics-progress.XXXXXX")
    chmod 0600 "$result_file" "$progress_file"
    cleanup_result() {
        rm -f "$result_file" "$progress_file"
    }
    trap cleanup_result EXIT HUP INT TERM
    status=0
    timeout 600 "$KUBESTR" "$@" --outfile "$result_file" >"$progress_file" 2>&1 || status=$?
    if [ "$status" -ne 0 ]; then
        cat "$progress_file" >&2
        exit "$status"
    fi
    cat "$result_file"
    cleanup_result
    trap - EXIT HUP INT TERM
}

PLAN=false
case "${1:-}" in
    plan)
        PLAN=true
        shift
        ;;
esac

operation=${1:-help}
[ "$#" -eq 0 ] || shift

case "$operation" in
    help|--help|-h)
        [ "$#" -eq 0 ] || fail "help accepts no arguments"
        usage
        ;;
    docs)
        [ "$#" -eq 0 ] || fail "docs accepts no arguments"
        printf '%s\n' \
            'upstream=/usr/share/breakglass/runbooks/upstream/storage-diagnostics' \
            'internal=/usr/share/breakglass/runbooks/internal (optional read-only image-volume mount)'
        ;;
    runbook)
        [ "$#" -eq 0 ] || fail "runbook accepts no arguments"
        [ -r "$UPSTREAM_RUNBOOK" ] || fail "the built-in upstream runbook is unavailable"
        cat "$UPSTREAM_RUNBOOK"
        ;;
    mounted-volume)
        [ "$PLAN" = false ] || fail "mounted-volume already provides storage-report --dry-run"
        [ -x "$STORAGE_REPORT" ] || fail "storage-report is unavailable"
        exec "$STORAGE_REPORT" "$@"
        ;;
    performance)
        parse_storage_class "$@"
        run_cluster_operation "$PLAN" "$operation" fio \
            --storageclass "$STORAGE_CLASS" \
            --size "$PVC_SIZE" \
            --testname default-fio \
            --namespace "$NAMESPACE" \
            --image "$WORKLOAD_IMAGE" \
            --output json
        ;;
    snapshot-restore|snapshot-source-clone)
        parse_snapshot_classes "$@"
        if [ "$operation" = snapshot-restore ]; then
            skip_clone=true
        else
            skip_clone=false
        fi
        run_cluster_operation "$PLAN" "$operation" csicheck \
            --storageclass "$STORAGE_CLASS" \
            --volumesnapshotclass "$SNAPSHOT_CLASS" \
            --namespace "$NAMESPACE" \
            --image "$WORKLOAD_IMAGE" \
            --runAsUser 65532 \
            --cleanup=true \
            --skipCFScheck="$skip_clone" \
            --output json
        ;;
    block-volume)
        [ "$#" -eq 2 ] || fail "block-volume requires exactly --storage-class NAME"
        [ "$1" = --storage-class ] || fail "block-volume requires --storage-class NAME"
        valid_kubernetes_name "$2" || fail "--storage-class must be a valid Kubernetes name"
        run_cluster_operation "$PLAN" "$operation" blockmount \
            --storageclass "$2" \
            --namespace "$NAMESPACE" \
            --image "$WORKLOAD_IMAGE" \
            --runAsUser 65532 \
            --cleanup=true \
            --wait-timeout 120 \
            --pvc-size 1Gi \
            --output json
        ;;
    *)
        fail "unsupported operation: $operation"
        ;;
esac
