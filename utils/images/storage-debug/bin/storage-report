#!/bin/sh
# SPDX-FileCopyrightText: 2026 Deutsche Telekom AG
# SPDX-License-Identifier: Apache-2.0

set -eu
umask 077

path=${STORAGE_TEST_PATH:-/scratch}
size_mb=${STORAGE_TEST_SIZE_MB:-16}
runtime_seconds=${STORAGE_TEST_RUNTIME_SECONDS:-5}
ioping_count=${STORAGE_IOPING_COUNT:-5}
output=
dry_run=false

fail() {
    printf 'storage-report: %s\n' "$1" >&2
    exit 1
}

trim_trailing_slash() {
    value=$1
    while [ "$value" != "/" ] && [ "${value%/}" != "$value" ]; do
        value=${value%/}
    done
    printf '%s' "$value"
}

require_positive_int() {
    value=$1
    name=$2
    min=$3
    max=$4
    case "$value" in
        ''|*[!0-9]*) fail "$name must be an integer" ;;
    esac
    [ "$value" -ge "$min" ] || fail "$name must be >= $min"
    [ "$value" -le "$max" ] || fail "$name must be <= $max"
}

reject_traversal() {
    case "$1" in
        *'/../'*|../*|*/..)
            fail "$2 must not contain path traversal"
            ;;
    esac
}

require_absolute_path() {
    case "$1" in
        /*) ;;
        *) fail "$2 must be absolute" ;;
    esac
}

validate_test_path() {
    reject_traversal "$path" '--path'
    require_absolute_path "$path" '--path'

    path_trimmed=$(trim_trailing_slash "$path")
    canonical=$(readlink -f -- "$path_trimmed" 2>/dev/null || true)
    [ -n "$canonical" ] || fail '--path must exist'
    [ -d "$canonical" ] || fail '--path must be a directory'
    canonical_trimmed=$(trim_trailing_slash "$canonical")

    if [ "$path_trimmed" != "$canonical_trimmed" ]; then
        fail '--path must not contain symlinks or unresolved components'
    fi

    path=$canonical_trimmed
}

validate_output_path() {
    [ -n "$output" ] || return 0

    reject_traversal "$output" '--output'
    require_absolute_path "$output" '--output'

    if [ -L "$output" ] || [ -e "$output" ]; then
        fail '--output must not already exist'
    fi

    report_root=${STORAGE_REPORT_DIR:-/reports}
    require_absolute_path "$report_root" 'STORAGE_REPORT_DIR'
    report_root_canonical=$(readlink -f -- "$report_root" 2>/dev/null || true)
    [ -n "$report_root_canonical" ] || fail 'STORAGE_REPORT_DIR must exist'
    [ -d "$report_root_canonical" ] || fail 'STORAGE_REPORT_DIR must be a directory'

    output_parent=$(dirname -- "$output")
    output_parent_canonical=$(readlink -f -- "$output_parent" 2>/dev/null || true)
    [ -n "$output_parent_canonical" ] || fail '--output parent directory must exist'

    case "$output_parent_canonical/" in
        "$report_root_canonical/"*) ;;
        *) fail '--output must stay within STORAGE_REPORT_DIR' ;;
    esac
}

print_help() {
    cat <<'USAGE'
Usage: storage-report [--path PATH] [--size-mb N] [--runtime-seconds N] [--ioping-count N] [--output PATH] [--dry-run]
USAGE
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --path)
            [ "$#" -ge 2 ] || fail '--path requires a value'
            path=$2
            shift 2
            ;;
        --size-mb)
            [ "$#" -ge 2 ] || fail '--size-mb requires a value'
            size_mb=$2
            shift 2
            ;;
        --runtime-seconds)
            [ "$#" -ge 2 ] || fail '--runtime-seconds requires a value'
            runtime_seconds=$2
            shift 2
            ;;
        --ioping-count)
            [ "$#" -ge 2 ] || fail '--ioping-count requires a value'
            ioping_count=$2
            shift 2
            ;;
        --output)
            [ "$#" -ge 2 ] || fail '--output requires a value'
            output=$2
            shift 2
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help|help)
            print_help
            exit 0
            ;;
        *)
            fail "unsupported argument: $1"
            ;;
    esac
done

require_positive_int "$size_mb" '--size-mb' 1 1024
require_positive_int "$runtime_seconds" '--runtime-seconds' 1 60
require_positive_int "$ioping_count" '--ioping-count' 1 20
validate_test_path
validate_output_path

scratch_file="$path/.storage-debug-fio.$$"
cleanup() {
    rm -f -- "$scratch_file"
}
trap cleanup EXIT HUP INT TERM

fio_runtime="${runtime_seconds}s"
fio_cmd="fio --name storage-debug --filename $scratch_file --rw readwrite --bs 4k --size ${size_mb}M --ioengine sync --iodepth 1 --time_based --runtime=${fio_runtime}"
ioping_cmd="ioping -c $ioping_count $path"

if [ "$dry_run" = true ]; then
    report=$(cat <<EOF_REPORT
schema_version=storage-debug/v1
mode=dry-run
path=$path
size_mb=$size_mb
runtime_seconds=$runtime_seconds
ioping_count=$ioping_count
fio_command=$fio_cmd
ioping_command=$ioping_cmd
EOF_REPORT
)
    if [ -n "$output" ]; then
        printf '%s\n' "$report" >"$output"
        chmod 600 "$output"
    fi
    printf '%s\n' "$report"
    exit 0
fi

fio_status=fail
ioping_status=fail

if timeout "$((runtime_seconds + 10))" \
    fio --name storage-debug --filename "$scratch_file" --rw readwrite --bs 4k \
    --size "${size_mb}M" --ioengine sync --iodepth 1 --time_based --runtime "$fio_runtime" \
    >/dev/null 2>&1; then
    fio_status=pass
fi

if timeout "$((runtime_seconds + 10))" \
    ioping -c "$ioping_count" "$path" >/dev/null 2>&1; then
    ioping_status=pass
fi

overall_status=fail
if [ "$fio_status" = pass ] && [ "$ioping_status" = pass ]; then
    overall_status=pass
fi

report=$(cat <<EOF_REPORT
schema_version=storage-debug/v1
path=$path
size_mb=$size_mb
runtime_seconds=$runtime_seconds
ioping_count=$ioping_count
fio_status=$fio_status
ioping_status=$ioping_status
overall_status=$overall_status
EOF_REPORT
)

if [ -n "$output" ]; then
    printf '%s\n' "$report" >"$output"
    chmod 600 "$output"
else
    printf '%s\n' "$report"
fi

[ "$overall_status" = pass ] || exit 1
