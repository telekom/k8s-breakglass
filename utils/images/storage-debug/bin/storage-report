#!/bin/sh
# SPDX-FileCopyrightText: 2026 Deutsche Telekom AG
# SPDX-License-Identifier: Apache-2.0

set -eu

usage() {
    cat <<'EOF'
storage-report: run bounded fio and ioping checks against an existing mount

Usage:
  storage-report [options]

Options:
  --path PATH             Existing test directory (default: $STORAGE_TEST_PATH)
  --size-mb N             fio file size, 1..1024 MiB (default: 16)
  --runtime-seconds N     fio/ioping runtime, 1..60 seconds (default: 5)
  --ioping-count N        ioping request count, 1..20 (default: 5)
  --output FILE           Write deterministic report to FILE (default: stdout)
  --dry-run               Validate options and print planned commands
  --help                  Show this help

The fio scratch file is removed on exit. Set STORAGE_TEST_PATH, rather than
editing this image, when a workload-specific mount is used.
EOF
}

is_uint() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

bounded_uint() {
    value=$1
    minimum=$2
    maximum=$3
    label=$4
    if ! is_uint "$value" || [ "$value" -lt "$minimum" ] || [ "$value" -gt "$maximum" ]; then
        echo "$label must be an integer between $minimum and $maximum" >&2
        exit 2
    fi
}

TEST_PATH=${STORAGE_TEST_PATH:-/scratch}
SIZE_MB=${STORAGE_TEST_SIZE_MB:-16}
RUNTIME_SECONDS=${STORAGE_TEST_RUNTIME_SECONDS:-5}
IOPING_COUNT=${STORAGE_IOPING_COUNT:-5}
OUTPUT=
DRY_RUN=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        --path)
            [ "$#" -ge 2 ] || { echo "--path needs a value" >&2; exit 2; }
            TEST_PATH=$2
            shift 2
            ;;
        --size-mb)
            [ "$#" -ge 2 ] || { echo "--size-mb needs a value" >&2; exit 2; }
            SIZE_MB=$2
            shift 2
            ;;
        --runtime-seconds)
            [ "$#" -ge 2 ] || { echo "--runtime-seconds needs a value" >&2; exit 2; }
            RUNTIME_SECONDS=$2
            shift 2
            ;;
        --ioping-count)
            [ "$#" -ge 2 ] || { echo "--ioping-count needs a value" >&2; exit 2; }
            IOPING_COUNT=$2
            shift 2
            ;;
        --output)
            [ "$#" -ge 2 ] || { echo "--output needs a value" >&2; exit 2; }
            OUTPUT=$2
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$TEST_PATH" in
    /*) ;;
    *) echo "--path must be an absolute path" >&2; exit 2 ;;
esac
bounded_uint "$SIZE_MB" 1 1024 "--size-mb"
bounded_uint "$RUNTIME_SECONDS" 1 60 "--runtime-seconds"
bounded_uint "$IOPING_COUNT" 1 20 "--ioping-count"

FIO_TIMEOUT=$((RUNTIME_SECONDS + 5))
FIO_FILE="$TEST_PATH/.storage-debug-fio"

if [ "$DRY_RUN" = true ]; then
    printf '%s\n' \
        "schema_version=storage-debug/v1" \
        "path=$TEST_PATH" \
        "fio_command=fio --name=storage-debug --filename=$FIO_FILE --size=${SIZE_MB}M --runtime=${RUNTIME_SECONDS}s --time_based --rw=readwrite --bs=4k --iodepth=1" \
        "fio_timeout_seconds=$FIO_TIMEOUT" \
        "ioping_command=ioping -c $IOPING_COUNT $TEST_PATH"
    exit 0
fi

[ -d "$TEST_PATH" ] || { echo "test path does not exist: $TEST_PATH" >&2; exit 1; }
[ -w "$TEST_PATH" ] || { echo "test path is not writable: $TEST_PATH" >&2; exit 1; }
command -v fio >/dev/null 2>&1 || { echo "fio is not installed" >&2; exit 1; }
command -v ioping >/dev/null 2>&1 || { echo "ioping is not installed" >&2; exit 1; }

temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/storage-debug.XXXXXX")
trap 'rm -rf "$temporary_dir" "$FIO_FILE"' EXIT HUP INT TERM

fio_status=0
ioping_status=0
timeout "$FIO_TIMEOUT" fio --name=storage-debug --filename="$FIO_FILE" \
    --size="${SIZE_MB}M" --runtime="${RUNTIME_SECONDS}s" --time_based \
    --rw=readwrite --bs=4k --iodepth=1 --group_reporting \
    --output-format=json >"$temporary_dir/fio.json" 2>"$temporary_dir/fio.err" || fio_status=$?

# ioping has its own count bound; timeout is a second, independent wall-clock
# guard for a hung filesystem or a broken utility.
timeout "$FIO_TIMEOUT" ioping -c "$IOPING_COUNT" "$TEST_PATH" \
    >"$temporary_dir/ioping.txt" 2>"$temporary_dir/ioping.err" || ioping_status=$?

if [ "$fio_status" -eq 0 ]; then fio_result=pass; else fio_result=fail; fi
if [ "$ioping_status" -eq 0 ]; then ioping_result=pass; else ioping_result=fail; fi

write_report() {
    if [ "$fio_status" -eq 0 ] && [ "$ioping_status" -eq 0 ]; then
        overall_result=pass
    else
        overall_result=fail
    fi
    printf '%s\n' \
        "schema_version=storage-debug/v1" \
        "path=$TEST_PATH" \
        "size_mib=$SIZE_MB" \
        "runtime_seconds=$RUNTIME_SECONDS" \
        "ioping_count=$IOPING_COUNT" \
        "fio_status=$fio_result" \
        "ioping_status=$ioping_result" \
        "overall_status=$overall_result"
}

if [ -n "$OUTPUT" ]; then
    case "$OUTPUT" in
        /*) ;;
        *) echo "--output must be an absolute path" >&2; exit 2 ;;
    esac
    output_dir=${OUTPUT%/*}
    [ "$output_dir" != "$OUTPUT" ] || output_dir=/
    [ -d "$output_dir" ] || { echo "report directory does not exist: $output_dir" >&2; exit 1; }
    report_tmp="$output_dir/.storage-report.tmp.$$"
    write_report >"$report_tmp"
    mv "$report_tmp" "$OUTPUT"
else
    write_report
fi

[ "$fio_status" -eq 0 ] && [ "$ioping_status" -eq 0 ]
