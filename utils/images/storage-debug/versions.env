# Image inputs. The base and builder images are pinned by digest in Dockerfile
# (Dependabot docker). kubestr and its Go module graph are pinned by
# kubestr/go.mod and kubestr/go.sum (Dependabot gomod); the linked module
# versions are recorded in /usr/share/breakglass/kubestr-build-info. Alpine
# package versions follow the base image and are recorded at build time in
# /usr/share/breakglass/installed-packages and the image SBOM.
BASE_IMAGE=alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
BUILD_IMAGE=golang:1.27.4@sha256:5e8afd493a7124a8586e134d9b532731161d4b9becf9dee5a5956b107426f93d
KUBESTR_SOURCE=https://github.com/kastenhq/kubestr
KUBESTR_LICENSE=Apache-2.0
KUBESTR_MODULE_LOCK=kubestr/go.mod
RUNTIME_PACKAGES=fio ioping
INSTALLED_PACKAGES=/usr/share/breakglass/installed-packages
