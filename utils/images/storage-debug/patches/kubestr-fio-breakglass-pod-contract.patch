+var (
+	fioPodID                    int64 = 65532
+	fioPodRunAsNonRoot                = true
+	fioPodNoPrivilegeEscalation       = false
+	fioPodAutomountToken              = false
+)
+
+// breakglassOwnerReferences makes the runner Pod own every generated object,
+// so Kubernetes garbage collection removes them when the session deletes the
+// runner even if kubestr is killed before its deferred cleanup runs.
+func breakglassOwnerReferences() []metav1.OwnerReference {
+	name, uid := os.Getenv("STORAGE_DEBUG_OWNER_POD_NAME"), os.Getenv("STORAGE_DEBUG_OWNER_POD_UID")
+	if name == "" || uid == "" {
+		return nil
+	}
+	return []metav1.OwnerReference{{APIVersion: "v1", Kind: "Pod", Name: name, UID: types.UID(uid)}}
+}
+
+// breakglassImagePullSecrets passes the runner's registry credentials to the
+// fio Pod, which otherwise uses the namespace's default ServiceAccount.
+func breakglassImagePullSecrets() []v1.LocalObjectReference {
+	var refs []v1.LocalObjectReference
+	for _, name := range strings.Split(os.Getenv("STORAGE_DEBUG_IMAGE_PULL_SECRETS"), ",") {
+		if name = strings.TrimSpace(name); name != "" {
+			refs = append(refs, v1.LocalObjectReference{Name: name})
+		}
+	}
+	return refs
+}
