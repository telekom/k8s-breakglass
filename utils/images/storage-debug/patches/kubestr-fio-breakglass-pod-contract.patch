+package fio
+
+import (
+	"context"
+	"testing"
+
+	"k8s.io/client-go/kubernetes/fake"
+)
+
+func TestBreakglassFioPodContract(t *testing.T) {
+	t.Setenv("STORAGE_DEBUG_OWNER_POD_NAME", "runner")
+	t.Setenv("STORAGE_DEBUG_OWNER_POD_UID", "0f8d3c1e-0000-4000-8000-000000000001")
+	t.Setenv("STORAGE_DEBUG_IMAGE_PULL_SECRETS", "registry, ,mirror")
+	stepper := &fioStepper{cli: fake.NewSimpleClientset(), podReady: &fakePodReadyChecker{}}
+	ctx := context.Background()
+
+	pvc, err := stepper.createPVC(ctx, "fast", "4Gi", "ns")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cm, err := stepper.loadConfigMap(ctx, &RunFIOArgs{Namespace: "ns"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	pod, err := stepper.createPod(ctx, "pvc", "cm", "file", "ns", nil, "image@sha256:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for kind, refs := range map[string]int{"pvc": len(pvc.OwnerReferences), "configmap": len(cm.OwnerReferences), "pod": len(pod.OwnerReferences)} {
+		if refs != 1 {
+			t.Fatalf("%s owner references = %d, want 1", kind, refs)
+		}
+	}
+	owner := pod.OwnerReferences[0]
+	if owner.Kind != "Pod" || owner.Name != "runner" || string(owner.UID) != "0f8d3c1e-0000-4000-8000-000000000001" {
+		t.Fatalf("unexpected owner %+v", owner)
+	}
+	if got := pod.Spec.ImagePullSecrets; len(got) != 2 || got[0].Name != "registry" || got[1].Name != "mirror" {
+		t.Fatalf("unexpected pull secrets %+v", got)
+	}
+	sc, csc := pod.Spec.SecurityContext, pod.Spec.Containers[0].SecurityContext
+	if sc == nil || *sc.RunAsUser != 65532 || *sc.FSGroup != 65532 || !*sc.RunAsNonRoot || sc.SeccompProfile == nil {
+		t.Fatalf("unexpected pod security context %+v", sc)
+	}
+	if csc == nil || *csc.AllowPrivilegeEscalation || len(csc.Capabilities.Drop) != 1 || csc.Capabilities.Drop[0] != "ALL" {
+		t.Fatalf("unexpected container security context %+v", csc)
+	}
+	if pod.Spec.AutomountServiceAccountToken == nil || *pod.Spec.AutomountServiceAccountToken {
+		t.Fatal("fio pod must not mount a ServiceAccount token")
+	}
+}
+
+func TestBreakglassFioWithoutOwnerEnv(t *testing.T) {
+	t.Setenv("STORAGE_DEBUG_OWNER_POD_NAME", "")
+	t.Setenv("STORAGE_DEBUG_OWNER_POD_UID", "")
+	t.Setenv("STORAGE_DEBUG_IMAGE_PULL_SECRETS", "")
+	if refs := breakglassOwnerReferences(); refs != nil {
+		t.Fatalf("owner references without env = %+v", refs)
+	}
+	if secrets := breakglassImagePullSecrets(); secrets != nil {
+		t.Fatalf("pull secrets without env = %+v", secrets)
+	}
+}
