#!/bin/sh
# SPDX-FileCopyrightText: 2026 Deutsche Telekom AG
# SPDX-License-Identifier: Apache-2.0
set -eu

usage() { printf '%s\n' 'Usage: debug-dns [--server SERVER] NAME'; }
server=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --server)
            [ "$#" -ge 2 ] || { usage >&2; exit 2; }
            server=$2; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        --) shift; break ;;
        -*) printf 'debug-dns: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
        *) break ;;
    esac
done
[ "$#" -eq 1 ] || { usage >&2; exit 2; }
name=$1

if command -v nslookup >/dev/null 2>&1; then
    if [ -n "$server" ]; then exec nslookup "$name" "$server"; fi
    exec nslookup "$name"
fi

command -v getent >/dev/null 2>&1 || {
    printf '%s\n' 'debug-dns: neither nslookup nor getent is available' >&2
    exit 127
}
[ -z "$server" ] || printf '%s\n' 'debug-dns: --server requires nslookup' >&2
exec getent hosts "$name"
