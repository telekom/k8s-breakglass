#!/bin/sh
# SPDX-FileCopyrightText: 2026 Deutsche Telekom AG
# SPDX-License-Identifier: Apache-2.0
set -eu

usage() { printf '%s\n' 'Usage: debug-tls [--timeout SECONDS] HOST[:PORT]'; }
timeout_seconds=${WORKLOAD_DEBUG_TIMEOUT:-10}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --timeout)
            [ "$#" -ge 2 ] || { usage >&2; exit 2; }
            timeout_seconds=$2; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        --) shift; break ;;
        -*) printf 'debug-tls: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
        *) break ;;
    esac
done
[ "$#" -eq 1 ] || { usage >&2; exit 2; }
endpoint=$1
case "$endpoint" in
    *:*) host=${endpoint%:*}; port=${endpoint##*:} ;;
    *) host=$endpoint; port=443 ;;
esac
[ -n "$host" ] && [ -n "$port" ] || { printf '%s\n' 'debug-tls: invalid endpoint' >&2; exit 2; }

printf 'TLS endpoint: %s:%s\n' "$host" "$port"
printf '\n' | timeout "$timeout_seconds" openssl s_client \
    -connect "$host:$port" -servername "$host" -brief 2>&1
