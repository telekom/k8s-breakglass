set -eu

usage() {
	cat >&2 <<'EOF'
Usage: node-maintenance <command> [options]

Commands (the only supported entrypoints):
  node-recovery             Collect read-only node evidence.
  network-repair            Run one explicitly selected network repair.
  kexec-recovery-validate   Validate fixed provider recovery inputs; never execute.
  kexec-recovery            Validate the same inputs, then kexec into them.
  hotfix-action             Plan, apply or roll back one controller-rendered
                            platform hotfix on this node.

The image does not provide an unrestricted shell entrypoint. Use a runbook and
pass an explicit target, evidence directory, and confirmation token.
EOF
}

if [ "$#" -eq 0 ]; then
	cat /etc/motd >&2
	usage
	exit 2
fi

command_name=$1
shift
case "$command_name" in
	node-recovery)
		exec /usr/local/libexec/node-maintenance/node-recovery "$@"
		;;
	network-repair)
		exec /usr/local/libexec/node-maintenance/network-repair "$@"
		;;
	kexec-recovery-validate)
		exec /usr/local/libexec/node-maintenance/kexec-recovery-validate "$@"
		;;
	kexec-recovery)
		exec /usr/local/libexec/node-maintenance/kexec-recovery "$@"
		;;
	hotfix-action)
		# Exec directly: hotfix steps carry their own deadlines and must never
		# run under the 10 s capture timeout of the shell helpers.
		exec /usr/local/sbin/hotfix-action "$@"
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		printf 'Unsupported command: %s\n' "$command_name" >&2
		usage
		exit 2
		;;
esac
