# Non-module tool inputs for CI and local development, included by the Makefile.
# Go tools (kustomize, controller-gen, setup-envtest, govulncheck, gosec,
# go-licenses, kind, actionlint) are pinned by their own Dependabot-tracked
# modules under hack/tools/<tool>/go.mod instead.

# golangci-lint is installed with `go install` at this version (see Makefile).
# The weekly Check Tool Updates workflow reports newer releases.
GOLANGCI_LINT_VERSION=v2.14.0

# Kubernetes version of the envtest assets downloaded by setup-envtest.
# Should track the same minor version as KIND_NODE_IMAGE in CI (patch may differ based on envtest availability)
ENVTEST_K8S_VERSION=1.36.0
