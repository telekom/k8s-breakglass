{
  "schemaVersion": 1,
  "description": "Every artifact the release publishes, bound to the digest subject that is signed, attested and verified. Utility images are derived from hack/utility-image-matrix.json. Checked by hack/verify-release-inventory.sh.",
  "gateSets": {
    "controller": {
      "signature": [
        {"file": ".github/workflows/release.yml", "contains": "cosign sign --yes ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}@"},
        {"file": ".github/workflows/release.yml", "contains": "cosign verify \"${REGISTRY_IMAGE}@${DIGEST}\""}
      ],
      "sbom": [
        {"file": ".github/workflows/release.yml", "contains": "--predicate sbom.spdx.json"},
        {"file": ".github/workflows/release.yml", "contains": "cosign verify-attestation \"${REGISTRY_IMAGE}@${DIGEST}\" --type spdxjson"}
      ],
      "provenance": [
        {"file": ".github/workflows/release.yml", "contains": "actions/attest-build-provenance"},
        {"file": ".github/workflows/release.yml", "contains": "gh attestation verify \"oci://${REGISTRY_IMAGE}@${DIGEST}\""}
      ]
    },
    "utility": {
      "signature": [
        {"file": ".github/workflows/release.yml", "contains": "cosign sign --yes \"${IMAGE}@${DIGEST}\""},
        {"file": "hack/resolve-release-refs.sh", "contains": "cosign verify \"${subject}\""},
        {"file": ".github/workflows/utility-release.yml", "contains": "cosign sign --yes \"${SUBJECT}\""},
        {"file": "hack/verify-utility-publication.sh", "contains": "cosign verify \"${signed_subject}\""}
      ],
      "sbom": [
        {"file": ".github/workflows/release.yml", "contains": "--predicate \"utility-${{ matrix.name }}.spdx.json\""},
        {"file": "hack/resolve-release-refs.sh", "contains": "verify-attestation \"${subject}\" --type spdxjson"},
        {"file": ".github/workflows/utility-release.yml", "contains": "--predicate \"${IMAGE_NAME}-linux-amd64.spdx.json\""},
        {"file": "hack/verify-utility-publication.sh", "contains": "cosign verify-attestation \"${sbom_subject}\" --type spdxjson"}
      ],
      "provenance": [
        {"file": ".github/workflows/release.yml", "contains": "--predicate \"utility-${{ matrix.name }}.provenance.json\""},
        {"file": "hack/resolve-release-refs.sh", "contains": "verify-attestation \"${subject}\" --type slsaprovenance1"},
        {"file": ".github/workflows/utility-release.yml", "contains": "actions/attest-build-provenance"},
        {"file": "hack/verify-utility-publication.sh", "contains": "gh attestation verify \"oci://${provenance_subject}\""}
      ]
    },
    "chart": {
      "signature": [
        {"file": ".github/workflows/release.yml", "contains": "cosign sign --yes \"${subject}\""},
        {"file": ".github/workflows/release.yml", "contains": "cosign verify \"${subject}\""}
      ],
      "sbom": [
        {"file": ".github/workflows/release.yml", "contains": "cosign attest --yes --type spdxjson --predicate \"${sbom}\" \"${subject}\""},
        {"file": ".github/workflows/release.yml", "contains": "cosign verify-attestation \"${subject}\" --type spdxjson"}
      ],
      "provenance": [
        {"file": ".github/workflows/release.yml", "contains": "cosign attest --yes --type slsaprovenance1 --predicate chart-provenance.json \"${subject}\""},
        {"file": ".github/workflows/release.yml", "contains": "cosign verify-attestation \"${subject}\" --type slsaprovenance1"}
      ]
    }
  },
  "utilityImages": {
    "publisher": ".github/workflows/release.yml",
    "subject": "\"${IMAGE}@${DIGEST}\"",
    "gateSet": "utility"
  },
  "artifacts": [
    {
      "name": "controller",
      "kind": "image",
      "source": "Dockerfile",
      "publisher": ".github/workflows/release.yml",
      "subject": "\"${REGISTRY_IMAGE}@${DIGEST}\"",
      "gateSet": "controller"
    },
    {
      "name": "escalation-config",
      "kind": "chart",
      "source": "charts/escalation-config/Chart.yaml",
      "publisher": ".github/workflows/release.yml",
      "subject": "subject=\"${docker_remote}@${digest}\"",
      "gateSet": "chart"
    },
    {
      "name": "debug-session-catalogue",
      "kind": "chart",
      "source": "charts/debug-session-catalogue/Chart.yaml",
      "publisher": ".github/workflows/release.yml",
      "subject": "subject=\"${docker_remote}@${digest}\"",
      "gateSet": "chart"
    }
  ],
  "excluded": [
    {"source": "e2e/images/tmux-debug/Dockerfile", "reason": "E2E test fixture image, built locally in CI and never pushed to a registry"},
    {"source": "e2e/fixtures/convergence-bindings/Chart.yaml", "reason": "E2E test fixture chart, installed from the checkout and never published"},
    {"source": "e2e/fixtures/convergence-installation/Chart.yaml", "reason": "E2E test fixture chart, installed from the checkout and never published"}
  ]
}
