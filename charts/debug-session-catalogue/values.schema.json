{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean" },
    "requesters": { "$ref": "#/definitions/identities" },
    "approvers": { "$ref": "#/definitions/identities" },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "clusterSelector": { "type": "object" }
      }
    },
    "targetNamespace": { "type": "string", "minLength": 1, "maxLength": 63 },
    "defaultDuration": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h|d)+$" },
    "maxDuration": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h|d)+$" },
    "maxConcurrentSessions": { "type": "integer", "minimum": 1 },
    "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
    "images": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/image" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/profile" }
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 }
  },
  "required": ["requesters", "approvers", "targets", "profiles"],
  "definitions": {
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "users": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["repository"],
      "oneOf": [
        { "required": ["tag"] },
        { "required": ["digest"] }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "minLength": 1, "maxLength": 40 },
        "intent": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "minLength": 1, "maxLength": 63 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "enabled": { "type": "boolean" },
        "elevated": { "type": "boolean" },
        "requiredElevation": { "type": "boolean" },
        "preset": { "type": "string", "enum": ["restricted", "elevated", "elevated-node"] },
        "imageKey": { "type": "string", "minLength": 1 },
        "image": { "$ref": "#/definitions/image" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "workloadType": { "type": "string", "enum": ["DaemonSet", "Deployment", "Job"] },
        "podOverridesTemplate": { "type": "string", "minLength": 1 },
        "extraDeployVariables": { "type": "array", "items": { "type": "object" } },
        "replicas": { "type": "integer", "minimum": 1 },
        "privileged": { "type": "boolean" },
        "allowPrivilegeEscalation": { "type": "boolean" },
        "hostPID": { "type": "boolean" },
        "allowExec": { "type": "boolean" },
        "serviceAccountName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "minLength": 1, "maxLength": 63 },
        "automountServiceAccountToken": { "type": "boolean" },
        "capabilities": { "type": "array", "items": { "type": "string", "enum": ["AUDIT_CONTROL", "BPF", "NET_ADMIN", "NET_RAW", "PERFMON", "SYS_ADMIN", "SYS_PTRACE"] } },
        "pod": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "volumeMounts": { "type": "array", "items": { "type": "object" } },
            "volumes": { "type": "array", "items": { "type": "object" } },
            "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
            "env": { "type": "array", "items": { "type": "object" } }
          }
        }
      },
      "required": ["name", "intent", "displayName", "description", "enabled", "elevated", "command", "args"],
      "oneOf": [
        { "required": ["imageKey"], "not": { "required": ["image"] } },
        { "required": ["image"], "not": { "required": ["imageKey"] } }
      ]
    }
  }
}
