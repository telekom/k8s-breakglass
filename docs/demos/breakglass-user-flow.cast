{"version":3,"term":{"cols":110,"rows":34},"timestamp":1786953550,"idle_time_limit":1.0,"command":"/Users/A92615428/git/GitHub/telekom/k8s-breakglass/e2e/record-breakglass-demo.sh --play","title":"Breakglass user journey: deny, approve, API access, DebugSession","env":{"SHELL":"/bin/zsh"}}
[0.408, "o", "Breakglass user journey\r\nE2E cluster: tenant-a | API: http://localhost:8080\r\nCredentials are held in memory and are not printed.\r\n\r\n1. A protected request is denied before approval\r\n$ POST /api/breakglass/webhook/authorize/tenant-a (get configmaps)\r\n"]
[0.051, "o", "HTTP 200\r\n"]
[0.013, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"allowed\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Access denied. To request temporary access via Breakglass, visit http://localhost:8080?search=tenant-a and open a new request. Include the reason for access, the target cluster, and the requested group(s). If you need help, contact your platform admins.\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n"]
[0.000, "o", "2. The requester discovers an available escalation\r\n$ GET /api/breakglassEscalations?activeOnly=true&cluster=tenant-a\r\n"]
[0.051, "o", "HTTP 200\r\n"]
[0.018, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"total\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"items\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n    \u001b[1;39m{\u001b[0m\r\n      \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"copilot-demo-20260817075910\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"escalatedGroup\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"complete-flow-test-admins\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"maxValidFor\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"30m\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"approvalTimeout\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"15m\"\u001b[0m\r\n    \u001b[1;39m}\u001b[0m\r\n  \u001b[1;39m]\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n3. The requester creates a temporary access request\r\n"]
[0.000, "o", "$ POST /api/breakglassSessions\r\n"]
[0.069, "o", "HTTP 201\r\n"]
[0.010, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"tenant-a-complete-flow-test-admins-hbgp4\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"namespace\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"default\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Pending\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.068, "o", "\r\n4. An authorized approver approves the request\r\n$ POST /api/breakglassSessions/{name}/approve\r\n"]
[0.056, "o", "HTTP 200\r\n"]
[0.012, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"tenant-a-complete-flow-test-admins-hbgp4\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Approved\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"approver\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"complete-flow-approver@example.com\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.055, "o", "\r\n5. The same protected request is now allowed\r\n$ POST /api/breakglass/webhook/authorize/tenant-a (get configmaps)\r\n"]
[0.047, "o", "HTTP 200\r\n"]
[0.009, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"allowed\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Allowed by RBAC (groupCount=1); see http://localhost:8080?search=tenant-a\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.000, "o", "\r\n6. Explicit deny policy still overrides an active session\r\n"]
[0.000, "o", "$ POST /api/breakglass/webhook/authorize/tenant-a (get secrets)\r\n"]
[0.040, "o", "HTTP 200\r\n"]
[0.012, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"allowed\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Denied by policy breakglass-e2e-deny-secrets-all-test; No breakglass flow available for your user; see http://localhost:8080?search=tenant-a\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n7. The requester reads the approved session through the REST API\r\n$ GET /api/breakglassSessions/{name}\r\n"]
[0.026, "o", "HTTP 200\r\n"]
[0.010, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"tenant-a-complete-flow-test-admins-hbgp4\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Approved\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"requestedBy\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"complete-flow-requester@example.com\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"grantedGroup\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"complete-flow-test-admins\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"expiresAt\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"2026-08-17T08:29:11Z\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n8. A developer discovers debug-session templates\r\n"]
[0.000, "o", "$ GET /api/debugSessions/templates\r\n"]
[0.032, "o", "HTTP 200\r\n"]
[0.007, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"total\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"templates\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n    \u001b[1;39m{\u001b[0m\r\n      \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-dev-debug-template\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"displayName\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Development Debug Session\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"requiresApproval\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"targetNamespace\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-debug\"\u001b[0m\r\n    \u001b[1;39m}\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1;39m]\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n9. The developer creates a temporary DebugSession\r\n"]
[0.000, "o", "$ POST /api/debugSessions\r\n"]
[0.069, "o", "HTTP 201\r\n"]
[0.023, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"debug-test-user-breakglass-hub-dkr260xn9x8i\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Pending\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"templateRef\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-dev-debug-template\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"cluster\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"targetNamespace\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-debug\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.139, "o", "\r\n10. The active DebugSession is available through the REST API\r\n$ GET /api/debugSessions/{name}\r\nHTTP 200\r\n"]
[0.007, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"debug-test-user-breakglass-hub-dkr260xn9x8i\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Active\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"requestedBy\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"test-user\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"cluster\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"templateRef\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-dev-debug-template\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1;34m\"targetNamespace\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-debug\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"expiresAt\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"2026-08-17T08:19:12Z\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.000, "o", "\r\nDemo complete. Temporary sessions are cleaned up after recording.\r\n"]
[0.111, "x", "0"]
