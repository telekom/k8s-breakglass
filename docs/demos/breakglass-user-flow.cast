[0.408, "o", "Breakglass CLI user journey\r\nCLI: bgctl | API: http://localhost:8080 | Cluster: breakglass-hub\r\nCredentials are held in memory and are not printed.\r\n\r\n1. CLI rejects an unauthorized escalation request\r\n$ bgctl session request --cluster breakglass-hub --group cluster-admin-access\r\n"]
[0.719, "o", "Error: request failed (403): user not authorized for requested group (correlationID=80a42e43-1773-4963-92bc-8b241df82b65)\r\n"]
[0.000, "o", "\r\n2. Requester lists available escalation policies\r\n$ bgctl escalation list -o json\r\n"]
[0.125, "o", "\u001b[1;39m[\u001b[0m\r\n  \u001b[1;39m{\u001b[0m\r\n    \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-e2e-escalation-emergency-admin-test\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"escalatedGroup\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-emergency-admin\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"clusters\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n      \u001b[0;32m\"breakglass-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[0;32m\"breakglass-hub-2\"\u001b[0m\r\n    \u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"approvers\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m{\u001b[0m\r\n      \u001b[1;34m\"groups\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n        \u001b[0;32m\"emergency-response\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n        \u001b[0;32m\"senior-ops\"\u001b[0m\r\n      \u001b[1;39m]\u001b[0m\r\n    \u001b[1;39m}\u001b[0m\r\n  \u001b[1;39m}\u001b[0m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[0.001, "o", "\r\n3. kubectl shows the requester identity and access before approval\r\n"]
[0.000, "o", "The Kubernetes identity is still ops-gamma@example.com; Breakglass changes authorization only after approval.\r\n$ kubectl auth whoami --as=ops-gamma@example.com --as-group=ops\r\n"]
[0.174, "o", "apiVersion: authentication.k8s.io/v1\r\nkind: SelfSubjectReview\r\nmetadata:\r\n  creationTimestamp: \"2026-08-17T08:54:57Z\"\r\nstatus:\r\n  userInfo:\r\n    groups:\r\n    - ops\r\n    - system:authenticated\r\n    username: ops-gamma@example.com\r\n"]
[0.011, "o", "$ kubectl auth can-i get configmaps --as=ops-gamma@example.com --as-group=ops\r\n"]
[3.107, "o", "no - Post \"http://breakglass.system.svc.cluster.local:8081/api/breakglass/webhook/authorize/tenant-a?timeout=3s\": net/http: request canceled while waiting for connection (Client.Timeout exceeded while awaiting headers)\r\n"]
[0.003, "o", "\r\n4. Requester creates a temporary session\r\n"]
[0.000, "o", "$ bgctl session request --cluster breakglass-hub --group breakglass-emergency-admin\r\n"]
[0.221, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub-breakglass-emergency-admin-vkdr8\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Pending\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"cluster\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"group\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-emergency-admin\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.154, "o", "\r\n5. Approver approves the session\r\n$ bgctl session approve SESSION_NAME --reason \"Approved for incident response\"\r\n"]
[0.212, "o", "Approval command completed: state=Approved\r\n\r\n6. Requester reads the active session and lists it\r\n$ bgctl session get SESSION_NAME -o json\r\n"]
[0.098, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub-breakglass-emergency-admin-vkdr8\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Approved\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"requestedBy\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"ops-gamma@example.com\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"grantedGroup\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-emergency-admin\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"expiresAt\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"2026-08-17T09:55:01Z\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.000, "o", "$ bgctl session list --mine -o json\r\n"]
[0.090, "o", "\u001b[1;39m[\u001b[0m\r\n  \u001b[1;39m{\u001b[0m\r\n    \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub-breakglass-emergency-admin-vkdr8\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Approved\"\u001b[0m\r\n  \u001b[1;39m}\u001b[0m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[0.004, "o", "\r\n7. kubectl sees the newly granted API access\r\nThe same identity now uses the approved Breakglass group for a Kubernetes API request.\r\n$ kubectl auth can-i get configmaps --as=ops-gamma@example.com --as-group=breakglass-emergency-admin\r\n"]
[0.078, "o", "yes\r\n"]
[0.003, "o", "$ kubectl get configmaps --as=ops-gamma@example.com --as-group=breakglass-emergency-admin\r\n"]
[0.081, "o", "configmap/kube-root-ca.crt\r\n"]
[0.002, "o", "\r\n8. Requester discovers debug templates\r\n$ bgctl debug template list -o json\r\n"]
[0.131, "o", "\u001b[1;39m[\u001b[0m\r\n  \u001b[1;39m{\u001b[0m\r\n    \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-dev-debug-template\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"displayName\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Development Debug Session\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"requiresApproval\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\r\n    \u001b[1;34m\"allowedClusters\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n      \u001b[0;32m\"breakglass-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[0;32m\"breakglass-hub-2\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[0;32m\"breakglass-tenant-a-config-test\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[0;32m\"breakglass-tenant-b-config-test\"\u001b[0m\r\n    \u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\r\n"]
[0.000, "o", "    \u001b[1;34m\"allowedGroups\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n      \u001b[0;32m\"platform-engineers\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[0;32m\"developers\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[0;32m\"dev\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[0;32m\"ops\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n"]
[0.000, "o", "      \u001b[0;32m\"requester\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n"]
[0.000, "o", "      \u001b[0;32m\"breakglass-pods-admin\"\u001b[0m\r\n"]
[0.000, "o", "    \u001b[1;39m]\u001b[0m\r\n  \u001b[1;39m}\u001b[0m\r\n\u001b[1;39m]\u001b[0m\r\n"]
[0.002, "o", "\r\n9. Requester creates and observes a DebugSession\r\n"]
[0.000, "o", "$ bgctl debug session create --template breakglass-dev-debug-template --cluster breakglass-hub\r\n"]
[0.149, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"debug-ops-user-gamma-breakglass-hub-dkr3crzb3vln\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Pending\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"templateRef\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-dev-debug-template\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"cluster\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"targetNamespace\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-debug\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.282, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"debug-ops-user-gamma-breakglass-hub-dkr3crzb3vln\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"state\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"Active\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"requestedBy\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"ops-user-gamma\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"cluster\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"breakglass-hub\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"expiresAt\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"2026-08-17T09:15:02Z\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.000, "o", "\r\n10. kubectl finds the spawned debug pod\r\n"]
[2.156, "o", "$ kubectl get pods -n breakglass-debug -l breakglass.telekom.com/debug-session=debug-ops-user-gamma-breakglass-hub-dkr3crzb3vln\r\n"]
[0.087, "o", "NAME                                                              READY   STATUS\r\ndebug-ops-user-gamma-breakglass-hub-dkr3crzb3vln-7b9577c9drjkw8"]
[0.000, "o", "   true    Running\r\n"]
[0.002, "o", "\r\n11. kubectl uses the spawned debug pod for tcpdump diagnostics\r\n"]
[0.000, "o", "The debug pod is a controlled netshoot workload created by DebugSession.\r\n"]
[0.000, "o", "$ kubectl exec -n breakglass-debug debug-ops-user-gamma-breakglass-hub-dkr3crzb3vln-7b9577c9drjkw8 -- tcpdump --version\r\n"]
[0.314, "o", "tcpdump version 4.99.6\r\nlibpcap version 1.10.6 (64-bit time_t, with TPACKET_V3)\r\n"]
[0.004, "o", "$ kubectl exec -n breakglass-debug debug-ops-user-gamma-breakglass-hub-dkr3crzb3vln-7b9577c9drjkw8 -- tcpdump -D\r\n"]
[0.100, "o", "1.eth0 [Up, Running, Connected]\r\n2.any (Pseudo-device that captures on all interfaces) [Up, Running]\r\n3.lo [Up, Running, Loopback]\r\n4.nflog (Linux netfilter log (NFLOG) interface) [none]\r\n5.nfqueue (Linux netfilter queue (NFQUEUE) interface) [none]\r\n"]
[0.006, "o", "\r\nCLI demo complete. Temporary sessions are cleaned up after recording.\r\n"]
[0.334, "x", "0"]
